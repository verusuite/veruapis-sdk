{
  "name": "@verusuite/api",
  "version": "1.0.0",
  "description": "Client for the VeruSuite API: mail, calendar and workspace administration.",
  "license": "MIT",
  "author": "North Wave MB",
  "homepage": "https://veruapis.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verusuite/veruapis-sdk.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/verusuite/veruapis-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "coverage": "c8 tsx --test test/*.test.ts",
    "check-spec": "node scripts/check-spec.mjs",
    "prepublishOnly": "npm run check-spec && npm run coverage && npm run build"
  },
  "keywords": [
    "verusuite",
    "veruapis",
    "email",
    "calendar",
    "api"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "c8": "^10.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "yaml": "^2.5.0"
  }
}
