<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 rather than the newest: a client library should not be the
         reason somebody upgrades their runtime, and 8 is the long-term
         support release everything current can consume. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- CS1591 wants a doc comment on every public member, which on a record of
         wire fields produces eighty repetitions of "Gets the Id". The comments
         in this library explain why a thing is the way it is, and a property
         whose name already says everything gets none. The documentation file
         still ships, so the comments that do earn their place reach a
         consumer's editor. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>VeruSuite.Api</PackageId>
    <Version>1.0.0</Version>
    <Authors>North Wave MB</Authors>
    <Description>Client for the VeruSuite API: mail, calendar and workspace administration.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://veruapis.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/verusuite/veruapis-sdk</RepositoryUrl>
    <PackageTags>verusuite;veruapis;email;calendar;api</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- No PackageReference. Every dependency in a client library becomes one in
       every program that installs it, and everything needed here is in the
       base class library: HttpClient and System.Text.Json. -->

  <ItemGroup>
    <InternalsVisibleTo Include="VeruSuite.Api.Tests" />
  </ItemGroup>

</Project>
